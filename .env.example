# Neo4j
NEO4J_PASSWORD=change-me-before-first-boot
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j

# LLM + embeddings (set whichever provider you use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Extraction model. Cheap + temperature 0 is right for schema-grounded extraction.
GRAPHRAG_LLM=gpt-4.1-mini
GRAPHRAG_EMBEDDER=text-embedding-3-small

# --- Claude-only setup -------------------------------------------------------
# Anthropic has no embeddings API, so extraction uses Claude and embeddings run
# locally via sentence-transformers. No second API key, works offline.
#   GRAPHRAG_LLM=claude-sonnet-5
#   GRAPHRAG_EMBEDDER_PROVIDER=local
#   GRAPHRAG_EMBEDDER=all-MiniLM-L6-v2       # 384 dims
#
# Providers: local | ollama | openai | cohere | mistral
GRAPHRAG_EMBEDDER_PROVIDER=local

# --- OpenAI-compatible gateway (Experiential Labs, OpenRouter, LiteLLM, vLLM) --
# Set a base URL and the gateway serves every slug over the OpenAI wire protocol,
# including Anthropic-named ones. Leave blank to call providers directly.
#   GRAPHRAG_LLM_BASE_URL=https://api.experientiallabs.ai/v1
#   GRAPHRAG_API_KEY=xpl_...
#   GRAPHRAG_LLM=<slug from scripts/list_models.py --cheapest>
GRAPHRAG_LLM_BASE_URL=
GRAPHRAG_API_KEY=
